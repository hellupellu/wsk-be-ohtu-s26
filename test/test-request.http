# api http test requests for VSCode
@apiUrl = http://127.0.0.1:3000/api/v1


### get cats
GET {{apiUrl}}/cats
Authorization: Bearer {{login.response.body.token}}

### get cat by id
GET {{apiUrl}}/cats/41

### get cat by id (FAIL: not found)
GET {{apiUrl}}/cats/98

# cat_name, weight, owner, filename, birthdate
### post new cat
POST {{apiUrl}}/cats
Content-Type: application/json

{
    "cat_name": "Rolle",
    "birthdate": "2022-10-10",
    "weight": 4,
    "owner": "Tiina",
    "filename": "https://placecats.com/310/240"
}

### post cat WITH IMAGE
POST http://127.0.0.1:3000/api/v1/cats HTTP/1.1
Content-Type: multipart/form-data; boundary=MyBoundary

--MyBoundary
Content-Disposition: form-data; name="cat_name"

Dogi
--MyBoundary
Content-Disposition: form-data; name="weight"

4
--MyBoundary
Content-Disposition: form-data; name="owner"

37
--MyBoundary
Content-Disposition: form-data; name="birthdate"

2022-10-08
--MyBoundary
Content-Disposition: form-data; name="cat"; filename="dog.jpg"
Content-Type: image/jpeg

< ./dog.jpg
--MyBoundary--

### edit existing cat
PUT {{apiUrl}}/cats/43
Content-Type: application/json

{
    "weight": 6,
    "cat_name": "Dogi Muokattu"
}

### delete cat by id
DELETE {{apiUrl}}/cats/43

### get all users
GET {{apiUrl}}/users

### get user by id
GET {{apiUrl}}/users/37

### get user by id (FAIL: not found)
GET {{apiUrl}}/users/9999

### get newly added cat from database
GET {{apiUrl}}/cats/43

### post new user
POST {{apiUrl}}/users
Content-Type: application/json

{
    "name": "Testi Käyttäjä",
    "username": "testikayttaja5",
    "email": "testi5@example.com",
    "password": "testpassword123",
    "role": "user"
}

### get newly added user
GET {{apiUrl}}/users/38

### update test user
PUT {{apiUrl}}/users/38
Content-Type: application/json

{
    "name": "Muokattu Testikäyttäjä",
    "username": "testikayttaja5",
    "email": "testi5@example.com",
    "role": "user"
}

### delete test user
DELETE {{apiUrl}}/users/38

### get deleted user (FAIL: not found)
GET {{apiUrl}}/users/38

### get cats by user id
GET {{apiUrl}}/users/37/cats

### get deleted cat (FAIL: not found)
GET {{apiUrl}}/cats/43

### Register new user
POST {{apiUrl}}/users
Content-Type: application/json

{
    "name": "Matti",
    "username": "matti",
    "email": "matti@example.com",
    "password": "salakala"
}

### User login
# @name login
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
    "username": "matti",
    "password": "salakala"
}

### Get my user info
GET http://localhost:3000/api/v1/auth/me
Authorization: Bearer {{login.response.body.token}}

### delete cat by id
DELETE {{apiUrl}}/cats/60
Authorization: Bearer {{login.response.body.token}}

### Update another user's cat (FAIL: not allowed)
PUT {{apiUrl}}/cats/41
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "weight": 7
}

### Update another user (FAIL: forbidden)
PUT {{apiUrl}}/users/37
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "name": "Muokattu käyttäjä"
}

### Delete another user (FAIL: forbidden)
DELETE {{apiUrl}}/users/37
Authorization: Bearer {{login.response.body.token}}

### Update own user info
PUT {{apiUrl}}/users/39
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "name": "Matti Muokattu"
}

### Check updated user info
GET {{apiUrl}}/users/39

### Try to change own role to admin
PUT {{apiUrl}}/users/39
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "role": "admin"
}

### Check user role
GET {{apiUrl}}/users/39

### Test 404 error handler
GET {{apiUrl}}/foobar

### Post cat without file (FAIL: missing file)
POST {{apiUrl}}/cats
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "cat_name": "Testikissa",
    "weight": 4,
    "birthdate": "2022-10-08"
}

### Register user with invalid data (FAIL: validation)
POST {{apiUrl}}/users
Content-Type: application/json

{
    "name": "Te",
    "username": "ab",
    "email": "vääräemail",
    "password": "123"
}

### Post cat with invalid data (FAIL: validation)
POST {{apiUrl}}/cats
Authorization: Bearer {{login.response.body.token}}
Content-Type: multipart/form-data; boundary=MyBoundary

--MyBoundary
Content-Disposition: form-data; name="cat_name"

Ab
--MyBoundary
Content-Disposition: form-data; name="weight"

-5
--MyBoundary
Content-Disposition: form-data; name="birthdate"

wrongdate
--MyBoundary
Content-Disposition: form-data; name="cat"; filename="dog.jpg"
Content-Type: image/jpeg

< ./dog.jpg
--MyBoundary--

### Get cat with invalid ID (FAIL: validation)
GET {{apiUrl}}/cats/abc

### Update cat with invalid data (FAIL: validation)
PUT {{apiUrl}}/cats/41
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "cat_name": "Ab",
    "weight": -5,
    "birthdate": "wrongdate"
}

### Get user with invalid ID (FAIL: validation)
GET {{apiUrl}}/users/abc

### Update user with invalid data (FAIL: validation)
PUT {{apiUrl}}/users/39
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "name": "Te",
    "username": "ab",
    "email": "wrongemail"
}

